{
  "name": "bottenmisa",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "pdf": "node scripts/sync-pdf-assets.mjs && PDF_PORT=${PDF_PORT:-4321} PDF_PATH=${PDF_PATH:-/pdf/productivity} concurrently -k -s first -n astro,pdf \"astro dev --host 127.0.0.1 --port ${PDF_PORT:-4321} --strictPort\" \"wait-on http://127.0.0.1:${PDF_PORT:-4321}${PDF_PATH:-/pdf/productivity} && node scripts/export-pdf.mjs\"",
    "pdf:en": "PDF_LANG=en PDF_PATH=/en/pdf/productivity pnpm pdf",
    "pdf:render": ".venv/bin/python scripts/render_pdf_pages.py output/opsec-bible-productivity-pt.pdf reports/pdf-pages",
    "pdf:render:en": ".venv/bin/python scripts/render_pdf_pages.py output/opsec-bible-productivity-en.pdf reports/pdf-pages-en",
    "pdf:check": ".venv/bin/python scripts/check_pdf_layout.py output/opsec-bible-productivity-pt.pdf --lang pt",
    "pdf:check:en": ".venv/bin/python scripts/check_pdf_layout.py output/opsec-bible-productivity-en.pdf --lang en"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.2",
    "@astrojs/sitemap": "^3.7.2",
    "@types/lodash": "^4.17.24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@unocss/astro": "^66.6.7",
    "@unocss/reset": "^66.6.7",
    "astro": "^6.1.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lodash": "^4.17.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "rough-notation": "^0.5.1",
    "sharp": "^0.34.5",
    "unocss": "^66.6.7",
    "use-lanyard": "^1.7.0"
  },
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "playwright": "^1.61.1",
    "wait-on": "^9.0.10"
  }
}
