---
import Bio from "./Bio.astro";
import RecentTracks from "./RecentTracks.astro";
import Ultrawide from "./misc/Ultrawide.astro";
import { LanyardStatus } from "./lanyard/LanyardStatus";
import { homeCopy, type Language } from "../i18n";

interface Props {
  language?: Language;
}

const { language = "pt" } = Astro.props;
const copy = homeCopy[language];
const donationAddress =
  "85mpeMoAmjKj7xDKLFJyToPX4Cbw2ZoT7SvW2AbHNe5wVYwY9pMygurDPkFDPXT11JENjwjeJUEZv5wgKDx7EmzZB6DFXJM";
const donationHref = `monero:${donationAddress}`;

---

<main class="flex justify-center w-full my-7xl lg:my-[10%] homepage px-4 md:px-6">
  <div class="flex flex-col gap-8 md:gap-12 mx-auto max-w-7xl w-full min-w-0 px-4 md:px-6">
    <div class="mb-4">
      <Bio language={language} />
    </div>

    <div class="flex flex-col gap-8 min-w-0 w-full lg:max-w-sm lg:ml-auto">
      <LanyardStatus client:load discordId="1184574519692767272" />
      <RecentTracks />
    </div>

    <footer class="donation-footer">
      <span>{language === "pt" ? "donations xmr" : "donations xmr"}</span>
      <a href={donationHref}>{donationAddress}</a>
    </footer>
  </div>
</main>

<Ultrawide />

<style>
  .donation-footer {
    display: grid;
    gap: 0.45rem;
    max-width: 100%;
    padding-top: 1rem;
    border-top: 1px solid rgb(148 163 184 / 0.16);
    color: var(--text-300);
    font-family: "Jetbrains Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .donation-footer span {
    color: var(--text-500);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: lowercase;
  }

  .donation-footer a {
    max-width: 100%;
    color: inherit;
    overflow-wrap: anywhere;
    text-decoration: none;
    transition:
      color 220ms ease,
      text-shadow 220ms ease;
  }

  .donation-footer a:hover {
    color: var(--text-800);
    text-shadow:
      0 0 8px rgb(201 166 255 / 0.62),
      0 0 18px rgb(122 78 180 / 0.32);
  }
</style>
